# T.O.P. Trainer environment variables
# Copy to .env.test, .env.demo or .env.production (see DEPLOYMENT.md)

# === PocketBase superuser (used by the setup scripts) ===
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=replace-with-a-long-random-password

# === Application admin (required for demo data; leave blank to skip) ===
PB_ADMIN_USER_EMAIL=
PB_ADMIN_USER_PASSWORD=
PB_ADMIN_USER_NAME=TOP Trainer Admin

# === Domain for Caddy (production only) ===
# === Google OAuth (optional; both or neither). Redirect URI: https://<DOMAIN>/api/oauth2-redirect ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DOMAIN=tracker.setbaas.nl
